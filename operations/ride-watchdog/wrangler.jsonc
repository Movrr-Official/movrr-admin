{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "movrr-ride-operations-watchdog",
  "account_id": "147db6fed4f442dd3eb80aae7701ce8a",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "MOVRR_ADMIN_ORIGIN": "https://admin.movrr.nl", "RIDE_OPS_WATCHDOG_ENABLED": "true" },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
