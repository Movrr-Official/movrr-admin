  "rootCauses": [
    {
      "defect": "Rider validation required verification_result.status, while the canonical historical SQL contract returns stored objects without status.",
      "affectedRows": 17,
      "totalRideRows": 66,
      "fix": "Optional string status, preserving absent evidence and rejecting malformed types; no fabricated verification, settlement or points.",
      "digests": {
        "/dashboard": "2531727657",
        "/dashboard/routes": "4007248634",
        "/dashboard/rides": "3530931112",
        "/dashboard/rewards": "2335976014",
        "/dashboard/notifications": "180408308",
        "/dashboard/settings": "1352413243"
      }
    },
    {
      "defect": "Layouts, pages and nested reader guards repeatedly resolved identity and organisation memberships.",
      "fix": "React request-scoped identity/session memoization and parallel independent organisation discovery. No shared account data cache."
    },
    {
      "defect": "Settings, notifications and routes depended on the full rider dashboard aggregate.",
      "fix": "Read only the canonical data used by each page; backend failures in unrelated services cannot break these pages."
    },
    {
      "defect": "Admin dashboard read-only Server Actions were serialized by the browser action dispatcher; several query functions imposed 300Ã¢â‚¬â€œ500ms artificial waits.",
      "fix": "Uncached same-origin GET reads retaining the existing reader guards, overlapping queries, removal of measured waits, and one shared user query for chart/statistics."
    },
    {
      "defect": "Wallet preparation repeated full Platform authentication for balance, ledger and final-balance HTTP requests.",
      "fix": "One authenticated read-only backend statement endpoint; the same canonical balance/ledger/balance consistency check, complete pagination, ownership checks and bounded retry remain."
    },
    {
      "defect": "Government profile discovery was redirected into employee cookie login by the proxy.",
      "fix": "Exact /api/v1/government/me routing to its existing bearer/capability/organisation-scoped handler; sibling paths remain protected."
    }
  ],
