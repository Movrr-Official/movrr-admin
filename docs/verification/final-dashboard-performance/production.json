  "rootCauses": [
    {
      "rank": 1,
      "cause": "Six remaining independent Admin reads still used the serial Server Action dispatcher.",
      "measuredImpact": "Today's baseline action sequence spanned 1.783s through 11.907s; initial data ended at 11.907s (previous capture 15.686s).",
      "fix": "Counts, current employee, maintenance, incident count, deletion monitor and intake-status reads use private no-store GET handlers and their original guarded readers. Mutation actions remain Server Actions."
    },
    {
      "rank": 2,
      "cause": "Application functions ran in iad1 while the configured Supabase database pooler is in eu-central-1.",
      "fix": "Both vercel.json files select fra1. Deployment function metadata verifies the change. No database or privilege changes.",
      "reference": "https://vercel.com/docs/functions/configuring-functions/region"
    },
    {
      "rank": 3,
      "cause": "The global maintenance banner and footer loaded settings audit history, updater metadata, email-provider and route-optimizer health checks.",
      "fix": "Only maintenanceMode, maintenanceScope, maintenanceMessage and appVersion are read under the existing settings.manage permission. Existing adminSettings prefix invalidation includes this query."
    },
    {
      "rank": 4,
      "cause": "Admin layout repeated identity/role queries, and MFA, policy and trusted-session checks were sequential.",
      "fix": "Layout reuses the existing React request-scoped guarded identity. Independent security checks overlap but all must finish successfully before access or session persistence. Next control-flow signals pass through unchanged."
    },
    {
      "rank": 5,
      "cause": "Rider Rewards and CSV export loaded unrelated campaigns, assignments, rides, notifications and preferences; overview loaded unused notifications/preferences.",
      "fix": "Financial views use the same complete authoritative Wallet statement and unchanged signed category calculations. Overview drops only unused reads. No private cross-request cache added."
    }
  ],
